#!/usr/bin/env bash
#MISE description="Preview the documentation site"

# The site is a smalldocs project in docs/smalldocs. Its Rust reference needs a
# nightly toolchain, which writes the JSON of rustdoc:
#   rustup toolchain install nightly-2026-11-12
set -e

uvx smalldocs==0.5.9 preview docs/smalldocs "$@"
